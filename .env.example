# Desenvolvimento/testes: banco local sem credenciais.
DATABASE_URL=sqlite:///./clinicaptf.db
DEMO_DATABASE_URL=sqlite:///./clinicaptf_demo.db
APP_ENV=development

# Desenvolvimento: substitua por um valor local, se necessário.
SECRET_KEY=change-me-in-your-local-env

# Produção: defina APP_ENV=production, uma SECRET_KEY forte e uma URL
# PostgreSQL por variáveis de ambiente ou por um arquivo .env não versionado.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# SECRET_KEY=gere-um-valor-forte-e-exclusivo